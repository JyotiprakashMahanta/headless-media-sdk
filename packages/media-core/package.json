{
  "name": "media-core",
  "version": "0.1.0",
  "description": "Framework-agnostic media SDK core. Zero UI, zero React, zero DOM.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
