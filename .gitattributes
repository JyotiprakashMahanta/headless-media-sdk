# Normalise line endings to LF in the repository, regardless of the OS the
# commit was made on. Without this, a Windows checkout stages CRLF and every
# file looks modified to a reviewer on macOS or Linux.
* text=auto eol=lf

# Never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
